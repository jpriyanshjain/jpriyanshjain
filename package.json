{
  "name": "custom-chatbot-solution",
  "version": "1.0.0",
  "description": "Custom chatbot solution to replace Zendesk with intent classification and AI agent",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "openai": "^4.24.7",
    "axios": "^1.6.2",
    "uuid": "^9.0.1",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "rate-limiter-flexible": "^4.0.1",
    "natural": "^6.10.0",
    "compromise": "^14.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "chatbot",
    "ai",
    "intent-classification",
    "customer-support"
  ],
  "author": "Priyansh Jain",
  "license": "MIT"
}